# ---------------------------------------------------------------------------
# Node / workspaces (apps/web, apps/android)
# ---------------------------------------------------------------------------
node_modules
dist
dist-ssr
dev-dist
coverage
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Env
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Android / Gradle (apps/android/android) — generated by `cap add android`
# and rebuilt on every `npm run sync:android`; never commit build output.
# ---------------------------------------------------------------------------
apps/android/android/app/build/
apps/android/android/build/
apps/android/android/.gradle/
apps/android/android/captures/
apps/android/android/local.properties
apps/android/android/.idea/
apps/android/android/*.iml
apps/android/android/app/release/
apps/android/android/app/debug/
*.keystore
*.jks
!debug.keystore

# Capacitor copies the web build into the native project on every sync —
# these are generated, not source.
apps/android/android/app/src/main/assets/public/
apps/android/android/app/src/main/assets/capacitor.config.json

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
